# Copy to .env.local for local dev (gitignored via *.local).
# For GitHub Pages, set the same names as repository Secrets.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Project Settings → API Keys → Publishable key (sb_publishable_...)
# Safe in the browser. Do NOT use the Secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy alias (still accepted by the app if publishable is unset):
# VITE_SUPABASE_ANON_KEY=...

# Leave unset for local `/` base. CI sets /BJJ_Automata/ for Pages.
# VITE_BASE_PATH=/BJJ_Automata/
