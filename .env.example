# Copy to .env.local for local dev (gitignored via *.local).
# For GitHub Pages, set the same names as repository Secrets.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Leave unset for local `/` base. CI sets /BJJ_Automata/ for Pages.
# VITE_BASE_PATH=/BJJ_Automata/
