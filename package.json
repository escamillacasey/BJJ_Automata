{
  "name": "bjj-automata",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "ingest": "node scripts/ingest-obsidian.mjs",
    "fetch:bjjgraph": "mkdir -p src/data/raw && curl -sL https://github.com/diogoseca/bjjgraph/releases/latest/download/graph.json.gz -o src/data/raw/graph.json.gz",
    "convert:bjjgraph": "node scripts/convert-bjjgraph.mjs",
    "sync:bjjgraph": "npm run fetch:bjjgraph && npm run convert:bjjgraph"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
